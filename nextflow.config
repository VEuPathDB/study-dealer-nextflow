params {
    gusHomeDir = "/path/to/gusHome"
    gusConfigFile = "/path/to/gusConfigFile" // we can't assume the gus config is in gus_home
    workflowDataDir = "$baseDir/data" // this mimics a workflow's data dir

    // Sample characteristics (stf: entity-sample.{tsv,yaml}) live together under
    // the workflow data dir, whatever mode consumes them. Shared by rnaseq,
    // chipChip and dnaseq -- the artifact and its purpose are the same in all
    // three, so there is one place to look and one thing to mount.
    sampleDetailsDir = "${params.workflowDataDir}/sample_details"

    mode = "rnaseq"
    outputDir = "$launchDir/results"
    //datasetName = "tgonGT1_crisprPhenotype_CrisprScreen_RSRC" // this can be used to filter to a single dataset
    datasetName = "" // this can be used to filter to a single dataset
    multiDatasetStudies = "${params.sampleDetailsDir}/multiDatasetStudy.json"
    studyWranglerTag = "1.0.27" // docker image tag for study-wrangler (use custom tag for local development)

    dryRunLoad = false // when true, echo the load command instead of running it
    workflowPath = "${params.workflowDataDir}/*/*/${params.mode}"
    filePatterns = [ebiRnaSeqCounts: "${params.workflowPath}/*/nextflowAnalysisDir/nextflow_output/analysis_output/{countsForEda,merged-0.25-eigengenes}*",
                    rnaSeqCounts: "${params.workflowPath}/*/bulkrnaseq/analysisDir/nextflowAnalysisDir/nextflow_output/analysis_output/countsForEda*",
                    rnaseqAiMetadata: "${params.sampleDetailsDir}/*/*.{tsv,yaml}",
                    antibodyArray: "${params.workflowPath}/${params.datasetName}/*.{txt,tab}",
                    cellularLocalization: "${params.workflowPath}/${params.datasetName}/*.{txt,tab}",
                    rflp: "${params.workflowPath}/${params.datasetName}/*.{txt,tab}",
                    phenotype: "${params.workflowPath}/${params.datasetName}/*.{txt,tab}",
                    dnaseq: "${params.workflowPath}/*/dnaseqNextflow/analysisDir/results/*/*_alignment_stats.tsv",
                    // one level deeper than the other modes: dnaseq studies are
                    // per reference organism, so the grouping key is project +
                    // organismAbbrev rather than a single study directory
                    dnaseqStf: "${params.sampleDetailsDir}/*/*/entity-sample.{tsv,yaml}"]
}

process {
  maxForks = 2
}

includeConfig "$baseDir/conf/singularity.config"
